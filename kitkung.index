<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <title>YouTube Downloader UI</title>
    <style>
        body { font-family: sans-serif; background: #121212; color: white; padding: 40px; text-align: center; }
        input { padding: 10px; width: 60%; border-radius: 5px; border: none; margin-bottom: 10px; }
        button { padding: 10px 20px; border-radius: 5px; border: none; background: #00ffcc; font-weight: bold; cursor: pointer; }
        .result { margin-top: 20px; }
        a { color: #00ffcc; text-decoration: none; font-size: 1.2em; }
    </style>
</head>
<body>

    <h2>🎥 YouTube MP3 / MP4 Downloader</h2>
    <input type="text" id="ytUrl" placeholder="วางลิงก์ YouTube ที่นี่...">
    <br>
    <button onclick="convertVideo()">ดึงลิงก์ดาวน์โหลด</button>

    <div class="result" id="resultContainer"></div>

    <script>
        async function convertVideo() {
            const url = document.getElementById('ytUrl').value;
            const resultDiv = document.getElementById('resultContainer');
            
            if(!url) {
                alert('กรุณาวางลิงก์ YouTube');
                return;
            }

            resultDiv.innerHTML = "กำลังประมวลผล...";

            // หมายเหตุ: ต้องสมัคร RapidAPI เพื่อรับ API Key และ API Endpoint มาใส่ตรงนี้
            const options = {
                method: 'GET',
                headers: {
                    'x-rapidapi-key': 'YOUR_RAPIDAPI_KEY_HERE', // ใส่ Key ของคุณ
                    'x-rapidapi-host': 'youtube-mp36.p.rapidapi.com'
                }
            };

            try {
                // ตัวอย่างการเรียกใช้ API แปลงไฟล์ (สมมุติ API YouTube to MP3)
                // const response = await fetch(`https://youtube-mp36.p.rapidapi.com/dl?id=${videoId}`, options);
                // const data = await response.json();
                
                // จำลองผลลัพธ์หลังจากได้ดาวน์โหลดลิงก์จาก API
                setTimeout(() => {
                    resultDiv.innerHTML = `
                        <p>ดึงข้อมูลสำเร็จ!</p>
                        <a href="#" target="_blank">📥 ดาวน์โหลดไฟล์ MP3 / MP4</a>
                    `;
                }, 1500);

            } catch (error) {
                resultDiv.innerHTML = "เกิดข้อผิดพลาดในการดึงข้อมูล";
            }
        }
    </script>
</body>
</html>
